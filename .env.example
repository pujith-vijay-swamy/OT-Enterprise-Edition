# ==============================================================================
# RepoTrace AI Enterprise — Environment Template
# Copy this file to '.env' in the project root: cp .env.example .env
# Then fill in the placeholder values marked with "your_..._here"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Web Console (Next.js / Vercel)
# ------------------------------------------------------------------------------
# The public URL of your deployed frontend (used for OAuth redirects & cookies)
# For local dev: http://localhost:3000
# For production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Python AST backend API base URL (with /api suffix)
# For local dev: http://localhost:4400/api
# For production: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_BASE=http://localhost:4400/api

# The Python AST backend root URL (without /api, used by cron keepalive)
# For local dev: http://localhost:4400
# For production: https://your-backend.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4400

# ------------------------------------------------------------------------------
# 2. Python AST Backend Engine (Render / Local)
# ------------------------------------------------------------------------------
PORT=4400
ENGINE_PORT=4400
HOST=0.0.0.0
GIT_CACHE_DIR=./cache/git_repos

# PR Gatekeeper Policies (STRICT_BLOCK | WARN_ONLY)
PRODUCTION_GATE_POLICY=STRICT_BLOCK
STAGING_GATE_POLICY=WARN_ONLY

# ------------------------------------------------------------------------------
# 3. GitHub OAuth 2.0 Credentials
#    Register your app at: https://github.com/settings/applications/new
#    IMPORTANT: In your GitHub OAuth App settings, set:
#      Homepage URL:              <same as NEXT_PUBLIC_APP_URL>
#      Authorization callback URL: <same as GITHUB_CALLBACK_URL below>
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Key (for RAG Voice Assistant)
#    Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
